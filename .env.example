# Copy to .env and fill in. `docker compose` overrides the host names below
# with the service names on its network.

# --- Redis ---
# Either one URL (e.g. redis://red-abc:6379, as hosting platforms provide)...
# REDIS_URL=redis://localhost:6379
# ...or all four of the following, which are required when REDIS_URL is unset.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change-me

# --- API ---
# Comma-separated origins allowed to call the API (required).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Pickled classifier loaded at start-up (required). Relative to the directory
# the API runs from, which is the repo root locally and /app in the containers.
# `make train` in analysis/ writes it.
AUDIO_MODEL_PATH=models/audio.pkl
# Optional, with its default:
# How long a WebSocket waits for a result before reporting a timeout.
# WS_TIMEOUT_SECONDS=300
