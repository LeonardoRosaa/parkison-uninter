# Base URL of the API. Audio is uploaded to {VITE_API_BASE}/audios.
# Default: http://localhost:8000
VITE_API_BASE=http://localhost:8000

# WebSocket URL for analysis updates. {requestId} is replaced with the id the
# upload returned; without the placeholder the id is appended to the path.
# Default: ws://localhost:8000/ws/{requestId}
VITE_WS_URL=ws://localhost:8000/ws/{requestId}

# Optional locale when the URL has no ?lang= / ?locale= param: en or pt-BR.
# Default: the browser language.
# VITE_LOCALE=pt-BR
